# =================================================================
# LLM API Keys Configuration (Template)
# 주의: 이 파일은 템플릿 파일입니다. 실제 키는 .env 파일에만 저장하세요.
# =================================================================

# 1. Google Gemini API Key (Gemini 2.5 Flash, 3.8 Flash, 2.0 Pro 추천용)
GEMINI_API_KEY=

# 2. OpenAI API Key (GPT-4o, o3-mini, o3, GPT-6-Astra 추천용)
OPENAI_API_KEY=

# 3. Anthropic API Key (Claude 3.7 Sonnet, Claude 3.5 Haiku, Opus 추천용)
ANTHROPIC_API_KEY=

# 4. DeepSeek API Key (DeepSeek-V3 / R1 공식 API 추천용)
DEEPSEEK_API_KEY=

# 5. Upstage Solar API Key (Solar Pro / Mini 한국어 특화 추천용)
UPSTAGE_API_KEY=

# 6. 오픈소스 초고속 추론 & 서빙 플랫폼 API Keys (선택 사항)
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
NOVITA_API_KEY=
SILICONFLOW_API_KEY=

# =================================================================
# 서버 및 네트워크 포트 설정
# =================================================================
PORT=8088

# =================================================================
# 관리자 IP 설정 (도메인 접속 시에도 접속자 통계 열람 허용)
# 쉼표(,)로 구분하여 여러 개 등록 가능 (예: 203.0.113.50,127.0.0.1)
# =================================================================
ADMIN_IPS=203.0.113.50,127.0.0.1

# =================================================================
# 개발자 실행 환경 설정 (localhost 전용 관리)
# =================================================================
APP_ENV=development
DEV_DEBUG_MODE=true
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=8088
DEV_API_TIMEOUT=10
DEV_DISABLE_CACHE=true

# =================================================================
# 🖥️ 커맨드 창(터미널/PowerShell/CMD)에서 웹사이트 실행하는 방법
# =================================================================
#
# 1. npm 명령어 실행 (가장 간편):
#    npm run dev
#
# 2. Python 통합 서버 실행:
#    python server.py 8088
#
# 3. 정적 웹 서버 실행:
#    python -m http.server 8088
# =================================================================
