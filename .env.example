# =================================================================
# LLM API Keys Configuration
# 주의: 이 파일은 외부에 절대 유출되지 않도록 .gitignore에 등록되어 있습니다.
# =================================================================

# OpenAI API Key (GPT-4o, o3-mini, GPT-6-Astra 추천용)
OPENAI_API_KEY=

# Google Gemini API Key (Gemini 2.5 Flash, 3.8 Flash 추천용)
GEMINI_API_KEY=

# Anthropic API Key (Claude Sonnet 3.7 / Opus 5 추천용)
ANTHROPIC_API_KEY=

# DeepSeek API Key (DeepSeek-V3 / R1 추천용)
DEEPSEEK_API_KEY=

# Upstage Solar API Key (Solar Pro / Mini 추천용)
UPSTAGE_API_KEY=

# 로컬 서버 포트
PORT=8088

# =================================================================
# 개발자 실행 환경 설정 (localhost 전용 관리)
# =================================================================
# 실행 모드 (development: 로컬 개발 환경 / production: 배포 환경)
APP_ENV=development

# 로컬 개발 디버그 모드 (true: 콘솔 상세 로그 및 로컬 상태 인디케이터 표시)
DEV_DEBUG_MODE=true

# AI 추천 백엔드 프록시 포트 및 호스트
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=8088

# AI API 요청 타임아웃 시간 (초 단위)
DEV_API_TIMEOUT=10

# 브라우저 자동 리로드/캐시 방지 헤더 활성화 (true / false)
DEV_DISABLE_CACHE=true

# =================================================================
# 🖥️ 커맨드 창(터미널/CMD/PowerShell)에서 웹사이트 실행하는 방법
# =================================================================
#
# [실행 환경]
# - Python 3.8 이상 (별도 외부 패키지 설치 필요 없음, Python 표준 라이브러리 기반)
# - 웹 브라우저 (Chrome, Edge, Whale, Safari 등)
# - 기본 접속 주소: http://localhost:8088
#
# -----------------------------------------------------------------
# [실행 방법 1 : AI 추천 백엔드 통합 서버 실행 (⭐ 권장)]
# -----------------------------------------------------------------
# 1. 윈도우 PowerShell 또는 명령 프롬프트(CMD)를 엽니다.
# 2. 프로젝트 폴더로 이동:
#    cd "c:\Antigravity_소스\WebSite\LLM 최저가찾기"
# 3. 실행 명령어 입력:
#    python server.py
# 4. 웹 브라우저를 열고 아래 주소로 접속:
#    http://localhost:8088
#    (※ .env에 등록된 GEMINI_API_KEY를 통해 실시간 생성형 AI 모델 추천 연동)
#
# -----------------------------------------------------------------
# [실행 방법 2 : 일반 정적 파이썬 웹서버 실행 (초간단 실행)]
# -----------------------------------------------------------------
#    python -m http.server 8088
#    (※ 백엔드 없이도 내장된 고성능 클라이언트 지능형 추천 엔진 100% 정상 작동)
#
# -----------------------------------------------------------------
# [실행 방법 3 : Node.js npx 환경에서 실행 시]
# -----------------------------------------------------------------
#    npx serve -l 8088
#
# -----------------------------------------------------------------
# [서버 종료(중지) 방법]
# -----------------------------------------------------------------
# - 커맨드 창(터미널)에서 [ Ctrl + C ] 키를 누르면 서버가 안전하게 종료됩니다.
# =================================================================

